{
  "name": "@liuhuoz/dsh-claude-mem",
  "version": "0.5.0",
  "description": "A DeepSeek Harness plugin that integrates claude-mem: query, context injection, manual save, and session lifecycle over a local claude-mem worker's HTTP API",
  "icon": "icon.png",
  "keywords": [
    "dsh-plugin",
    "claude-mem",
    "memory",
    "deepseek-harness"
  ],
  "license": "Apache-2.0",
  "author": "liuhuoz",
  "contributors": [
    "Bleed00 (upstream author)"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liuhuoz/dsh-claude-mem.git"
  },
  "bugs": {
    "url": "https://github.com/liuhuoz/dsh-claude-mem/issues"
  },
  "homepage": "https://github.com/liuhuoz/dsh-claude-mem#readme",
  "engines": {
    "dsh": ">=0.2.1",
    "node": ">=20.12.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json && tsdown",
    "build": "npm run prepare",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
